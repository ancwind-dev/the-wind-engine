// Свои здания для редактора карт. Знаки: # дом, % бетон, = забор, @ скала,
// . пол (бетон), _ дорога (асфальт), - пусто, пробел — не трогать.
// Здания отсюда видны в редакторе (инструмент «Здания»); сюда же сохраняется
// выделенное кнопкой «Сохранить как здание».
[
    (
        name: "Пост охраны",
        rows: [
            "%%%..%%%",
            "%......%",
            "%..%%..%",
            "%......%",
            "%%%%%%%%",
        ],
    ),
]
