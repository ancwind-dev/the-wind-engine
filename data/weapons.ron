// Оружие. Числа сверены с .weapon-файлами RWR (темп, магазин, рост разброса),
// дальность и скорость — в наших метрах. Модели — свои, из data/models/weapons.
//
// retrigger_time — пауза между выстрелами, с; reload_time — перезарядка, с;
// projectile_speed — м/с; range — дальность, м; spread_deg — разброс первого выстрела;
// sustained_fire_grow_step — на сколько (долей начального) растёт разброс с каждым
// выстрелом очереди, sustained_fire_diminish_rate — сколько долей спадает за секунду
// (больше чем втрое разброс не вырастает);
// kill_probability — вероятность убить попаданием, иначе ранит на wound_damage;
// blast — у гранатомётов: снаряд летит в точку прицела и взрывается.
(
    weapons: [
        (
            name: "m4",
            model: "weapons/m4",
            retrigger_time: 0.113,
            magazine_size: 30,
