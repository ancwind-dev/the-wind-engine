// Параметры симуляции. Лаборатория (wind_lab) подхватывает изменения файла на лету.
// map_size, soldiers_per_team и capture_points применяются после перезапуска матча.
(
    map_size: 512,
    soldiers_per_team: 300,
    capture_points: 5,
    tick_rate: 20,
    think_interval: 5,
    // Солдат на своей точке при каждом «обдумывании» (4 раза в секунду) остаётся
    // с этой вероятностью. 0.97 — в среднем уходит дальше примерно через 8 секунд.
    defend_probability: 0.97,

    soldier: (
        speed: 4.5,
        radius: 0.35,
        vision_range: 55.0,
        vision_candidates: 4,
        respawn_time: 6.0,
    ),

    // Названия полей — как в .weapon-файлах RWR.
    weapon: (
        retrigger_time: 0.15,
        magazine_size: 30,
        reload_time: 2.5,
        projectile_speed: 90.0,
        range: 50.0,
        spread_deg: 4.0,
        kill_probability: 0.6,
        wound_damage: 0.4,
    ),

    grenade: (
        count: 2,
        throw_speed: 14.0,
        fuse: 2.0,
        blast_radius: 6.0,
        kill_probability: 0.9,
        wall_damage: 160.0,
        wall_damage_radius: 3.0,
        min_distance: 8.0,
        max_distance: 30.0,
        min_enemies: 3,
        interval: 15.0,
    ),

    // Отряды: size солдат с командиром (0 — без отрядов, каждый сам по себе).
    // Командир выбирает точку и ведёт отряд; бойцы держат место в строю в spacing
    // метрах друг от друга (в пути — клином, на точке — цепью). Боец дальше leash м
    // от своего места не ввязывается в бой, а догоняет; дальше rejoin м — идёт к точке
    // отряда сам. Применяется после перезапуска матча.
    squad: (
        size: 6,
        spacing: 3.0,
        leash: 16.0,
        rejoin: 25.0,
    ),

    // Укрытия. Стены в полный рост, поэтому укрытие — угол: место у стены, откуда
    // врага видно, и рядом — откуда не видно. Солдат стреляет из-за угла и прячется
    // за него на перезарядке. Ищет в search_radius м от себя (боец отряда — от места
    // в строю), не чаще раза в research с; держится угла hold с после боя
    // (search_radius: 0 — без укрытий). Пуля ближе near_miss м — «по мне стреляют»,
    // это помнится under_fire с: солдат ищет укрытие, даже не видя стрелка.
    cover: (
        search_radius: 12.0,
        hold: 4.0,
        research: 1.0,
        near_miss: 2.0,
        under_fire: 3.0,
    ),

    // Подавление огнём и раненые (только у ИИ; заживают раны и у игрока).
    // Пуля ближе near_miss (см. cover) добавляет per_near_miss подавления, попадание —
    // per_hit; спадает на decay в секунду. Подавленный мажет: разброс × (1 + подавление
    // × spread_penalty). Выше prone_at солдата прижимает: в поле он залегает (ползёт со
    // скоростью crawl, мишень меньше — prone_target радиуса), в укрытии прячется за угол;
    // встаёт ниже stand_at. Автоматчик, потерявший врага, suppress_memory секунд бьёт
    // туда, где тот был. Раненый (здоровье ниже retreat_below) отходит к своей точке
    // подальше от врага или на базу; вне боя (heal_delay с) заживает на heal_rate в
    // секунду и возвращается, когда здоровье выше return_above.
    suppression: (
        per_near_miss: 0.12,
        per_hit: 0.35,
        decay: 0.25,
        spread_penalty: 1.5,
        prone_at: 0.6,
        stand_at: 0.25,
        prone_target: 0.55,
        crawl: 0.25,
        suppress_memory: 3.0,
        retreat_below: 0.65,
        return_above: 0.9,
        heal_rate: 0.03,
        heal_delay: 5.0,
    ),

    // Штаб команды: раз в interval секунд раздаёт отрядам точки. Своей точке под
    // угрозой (враги ближе threat_radius м) — подкрепления: enemy_weight бойцов на
    // врага плюс garrison; ничьей и чужой — enemy_weight на врага плюс attack_extra;
    // своей спокойной на линии фронта — garrison (в тылу — никого). Атаку не по силам
    // не начинают; лишние отряды усиливают атаку, где бой жарче. Отряд, уже идущий к
    // точке, разворачивают неохотно (stickiness м). enabled: false — отряды выбирают
    // точки сами, как раньше.
    command: (
        enabled: true,
        interval: 5.0,
        threat_radius: 40.0,
        garrison: 3.0,
        attack_extra: 12.0,
        enemy_weight: 2.5,
        stickiness: 60.0,
    ),

    capture: (
        radius: 10.0,
        time: 12.0,
    ),

    // Раунд: побеждает команда, удержавшая все точки hold_time секунд; если за
    // time_limit секунд никто не победил — у кого больше точек (поровну — ничья).
    // Потом intermission секунд итогов и новый раунд на той же карте.
    round: (
        hold_time: 60.0,
        time_limit: 1200.0,
        intermission: 15.0,
    ),
)
